<form class="{{cssClass}} sw25-monster-sheet" autocomplete="off">
  <header class="monster-header">
    <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div><input class="monster-name" name="name" value="{{actor.name}}"><div class="monster-subtitle">Level <input type="number" name="system.level" value="{{system.level}}"> <input name="system.species" placeholder="Monster Species" value="{{system.species}}"> <input name="system.monsterType" value="{{system.monsterType}}" placeholder="Monster type"></div></div>
    {{#if isGM}}<div class="monster-gm-actions"><button type="button" data-action="import-monster"><i class="fas fa-file-import"></i> Import</button><button type="button" class="reveal-monster {{#if system.revealed}}active{{/if}}" data-action="toggle-monster-reveal"><i class="fas {{#if system.revealed}}fa-eye-slash{{else}}fa-eye{{/if}}"></i> {{#if system.revealed}}Hide from Players{{else}}Reveal to Players{{/if}}</button></div>{{/if}}
  </header>
  {{#if canRead}}
  <div class="monster-sheet-body">
    <section class="monster-grid monster-overview">
      <label>Intelligence<input name="system.intelligence" value="{{system.intelligence}}"></label><label>Perception<input name="system.perception" value="{{system.perception}}"></label><label>Disposition<input name="system.disposition" value="{{system.disposition}}"></label><label>Soulscars<input type="number" name="system.soulscars" value="{{system.soulscars}}"></label>
      <label>Languages<input name="system.languages" value="{{system.languages}}"></label><label>Habitat<input name="system.habitat" value="{{system.habitat}}"></label><label>Reputation<input type="number" name="system.reputation" value="{{system.reputation}}"></label><label>Weakness<input type="number" name="system.weakness" value="{{system.weakness}}"></label>
      <label class="wide">Weak Point<input name="system.weakPoint" value="{{system.weakPoint}}"></label><label>Initiative<span class="monster-initiative-control"><input type="number" name="system.initiative" value="{{system.initiative}}">{{#if isGM}}<button type="button" data-action="roll-monster-initiative" title="Roll side initiative"><i class="fas fa-dice-d6"></i></button>{{/if}}</span></label><label>Movement<input name="system.movementSpeed" value="{{system.movementSpeed}}"></label><label>Fortitude<span class="monster-check-control"><input name="system.fortitude" value="{{system.fortitude}}"><button type="button" data-action="roll-monster-resistance" data-check="fortitude" title="Roll Fortitude"><i class="fas fa-dice-d6"></i></button></span></label><label>Willpower<span class="monster-check-control"><input name="system.willpower" value="{{system.willpower}}"><button type="button" data-action="roll-monster-resistance" data-check="willpower" title="Roll Willpower"><i class="fas fa-dice-d6"></i></button></span></label>
    </section>

    <section class="monster-panel"><h2>Combat Statistics {{#if isGM}}<button type="button" data-action="add-monster-style"><i class="fas fa-plus"></i></button>{{/if}}</h2>
      {{#if mainCombatStyleIncomplete}}<p class="monster-main-section-incomplete">Select exactly one Main Section.</p>{{/if}}
      <div class="monster-main-combat-head"><span>Main</span><span>Style</span><span>Section</span><span>Accuracy</span><span>Damage</span><span>Evasion</span><span>Defense</span><span>HP</span><span>MP</span><span></span></div>
      {{#each combatStyles as |style|}}<div class="monster-main-combat-row">
        <input type="checkbox" data-action="select-main-combat-style" data-index="{{style.index}}" aria-label="Main Section: {{style.styleName}}" {{#if style.isMainSection}}checked{{/if}} {{#if style.mainSectionCheckboxDisabled}}disabled{{/if}} {{#unless ../isGM}}disabled{{/unless}}>
        <input name="system.combatStyles.{{style.index}}.style" value="{{style.styleName}}"><input name="system.combatStyles.{{style.index}}.section" value="{{style.section}}"><span class="rollable-stat"><button type="button" data-action="roll-monster-accuracy" data-index="{{style.index}}" title="Roll Accuracy"><i class="fas fa-dice-d6"></i></button><button type="button" data-action="call-monster-evasion" data-index="{{style.index}}" title="Call for Evasion against static Accuracy"><i class="fas fa-shield-halved"></i></button><input name="system.combatStyles.{{style.index}}.accuracy" value="{{style.accuracy}}" title="Accuracy modifier and static value"></span>
        <span class="rollable-stat"><button type="button" data-action="roll-monster-damage" data-index="{{style.index}}"><i class="fas fa-dice-d6"></i></button><input name="system.combatStyles.{{style.index}}.damage" value="{{style.damage}}" title="Damage formula"></span>
        <input name="system.combatStyles.{{style.index}}.evasion" value="{{style.evasion}}">{{#if style.defenseEditable}}<input type="number" name="system.combatStyles.{{style.index}}.defense" value="{{style.defense}}">{{else}}<span>{{style.defense}}</span>{{/if}}<span class="paired">{{#if style.hpValueEditable}}<input type="number" name="system.combatStyles.{{style.index}}.hp.value" value="{{style.hp.value}}">{{else}}<span>{{style.hp.value}}</span>{{/if}}/{{#if style.hpMaxEditable}}<input type="number" name="system.combatStyles.{{style.index}}.hp.max" value="{{style.hp.max}}">{{else}}<span>{{style.hp.max}}</span>{{/if}}</span><span class="paired">{{#if style.mpValueEditable}}<input type="number" name="system.combatStyles.{{style.index}}.mp.value" value="{{style.mp.value}}">{{else}}<span>{{style.mp.value}}</span>{{/if}}/{{#if style.mpMaxEditable}}<input type="number" name="system.combatStyles.{{style.index}}.mp.max" value="{{style.mp.max}}">{{else}}<span>{{style.mp.max}}</span>{{/if}}</span>{{#if ../isGM}}<button type="button" data-action="delete-monster-style" data-index="{{style.index}}"><i class="fas fa-trash"></i></button>{{/if}}
      </div>{{/each}}
    </section>

    <section class="monster-panel monster-unique-skills"><h2>Unique Skills {{#if isGM}}<button type="button" data-action="add-monster-skill"><i class="fas fa-plus"></i></button>{{/if}}</h2>
      {{#each uniqueSkillGroups as |group|}}
      {{#if group.showHeading}}<h3 class="monster-skill-section-heading">{{group.title}}</h3>{{/if}}
      {{#each group.skills as |skill|}}
      <article class="monster-ability {{#if skill.sectionAssignmentChoices.length}}has-section-assignment{{/if}}">
        <input name="system.uniqueSkills.{{skill.index}}.title" value="{{skill.title}}">
        {{#if @root.isGM}}{{#if skill.sectionAssignmentChoices.length}}<button type="button" class="monster-skill-assignment-button {{#if skill.sectionAssignmentNeedsReview}}needs-review{{/if}}" data-action="choose-monster-skill-section" data-index="{{skill.index}}" aria-label="Change section assignment: {{skill.sectionAssignmentLabel}}" title="Section: {{skill.sectionAssignmentLabel}}" {{#if skill.sectionAssignmentNeedsReview}}data-monster-skill-assignment-invalid{{/if}}><i class="fas fa-tag"></i></button>{{/if}}{{/if}}
        <button type="button" data-action="post-monster-skill" data-index="{{skill.index}}" title="Post ability to chat"><i class="fas fa-comment"></i></button>
        {{#if @root.isGM}}<button type="button" data-action="delete-monster-skill" data-index="{{skill.index}}" title="Delete ability"><i class="fas fa-trash"></i></button>{{/if}}
        {{#if skill.sectionAssignmentNeedsReview}}<p class="monster-skill-assignment-warning">This skill's previous section is no longer available. Assign it to a current section or All Sections.</p>{{/if}}
        <textarea name="system.uniqueSkills.{{skill.index}}.description">{{skill.description}}</textarea>
      </article>
      {{/each}}
      {{/each}}
    </section>

    <section class="monster-panel monster-loot"><h2>Loot Table <button type="button" data-action="roll-monster-loot"><i class="fas fa-dice-d6"></i> Roll Loot</button>{{#if isGM}}<button type="button" data-action="add-monster-loot"><i class="fas fa-plus"></i></button>{{/if}}</h2>{{#each lootTable as |entry|}}<div><input name="system.lootTable.{{entry.index}}.roll" value="{{entry.roll}}"><input name="system.lootTable.{{entry.index}}.loot" value="{{entry.loot}}">{{#if ../isGM}}<button type="button" data-action="delete-monster-loot" data-index="{{entry.index}}"><i class="fas fa-trash"></i></button>{{/if}}</div>{{/each}}</section>
    <section class="monster-panel"><h2>Description</h2><textarea class="monster-description" name="system.description">{{system.description}}</textarea><label>Source <input name="system.source" value="{{system.source}}"></label><label>Source URL <input name="system.sourceUrl" value="{{system.sourceUrl}}"></label></section>
  </div>
  {{else}}<div class="monster-hidden"><i class="fas fa-eye-slash"></i><p>This monster has not been revealed.</p></div>{{/if}}
</form>
