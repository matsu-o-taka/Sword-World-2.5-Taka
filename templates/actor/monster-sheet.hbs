<form class="{{cssClass}} sw25-monster-sheet" autocomplete="off">
  <header class="monster-header">
    <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div><input class="monster-name" name="name" value="{{actor.name}}"><div class="monster-subtitle">Level <input type="number" name="system.level" value="{{system.level}}"> <input name="system.species" placeholder="Monster Species" value="{{system.species}}"> <input name="system.monsterType" value="{{system.monsterType}}" placeholder="Monster type"><button type="button" class="monster-knowledge-button" data-action="roll-monster-knowledge" title="Roll Monster Knowledge against this monster"><i class="fas fa-search"></i></button><label class="monster-toggle-label">Active Combat Rolls<input type="checkbox" name="system.activeCombatRolls" {{#if system.activeCombatRolls}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}></label></div></div>

  </header>
  <div class="monster-sheet-body">
    <section class="monster-grid monster-overview">
      <label>Intelligence<input name="system.intelligence" value="{{system.intelligence}}"></label><label>Perception<input name="system.perception" value="{{system.perception}}"></label><label>Disposition<input name="system.disposition" value="{{system.disposition}}"></label><label>Soulscars<input type="number" name="system.soulscars" value="{{system.soulscars}}"></label>
      <label>Languages<input name="system.languages" value="{{system.languages}}"></label><label>Habitat<input name="system.habitat" value="{{system.habitat}}"></label><label>Reputation<input name="system.reputation" value="{{system.reputation}}"></label><label>Weakness<input name="system.weakness" value="{{system.weakness}}"></label>
      <label class="wide">Weak Point<input name="system.weakPoint" value="{{system.weakPoint}}">{{#if weaknessKnown}}<span class="weakness-known-indicator" title="Weakness known for this species">&#10003;</span>{{/if}}</label><label>Initiative<input type="number" name="system.initiative" value="{{system.initiative}}"></label><label>Movement<input name="system.movementSpeed" value="{{system.movementSpeed}}"></label><label>Fortitude<span class="monster-check-control"><input name="system.fortitude" value="{{system.fortitude}}"><button type="button" data-action="roll-monster-resistance" data-check="fortitude" title="Roll Fortitude"><i class="fas fa-dice-d6"></i></button></span></label><label>Willpower<span class="monster-check-control"><input name="system.willpower" value="{{system.willpower}}"><button type="button" data-action="roll-monster-resistance" data-check="willpower" title="Roll Willpower"><i class="fas fa-dice-d6"></i></button></span></label>
    </section>

    <section class="monster-panel"><h2>Combat Statistics <span class="monster-section-policy" title="How this monster's marked Main Sections incapacitate it">{{mainSectionPolicyLabel}}{{#if isGM}}<button type="button" class="monster-section-policy-button" data-action="configure-main-sections" title="Configure Main Section interpretation (Any / All / None)"><i class="fas fa-gear"></i></button>{{#if concealedMainSectionActive}}<button type="button" class="monster-section-randomize-button" data-action="randomize-concealed-main-section" title="Re-randomize concealed Main Section (new random selection for this individual)."><i class="fas fa-random"></i></button>{{/if}}{{/if}}</span>{{#if isGM}}<button type="button" data-action="add-monster-style"><i class="fas fa-plus"></i></button>{{/if}}</h2>
      {{#if mainCombatStyleIncomplete}}<p class="monster-main-section-incomplete">Select a Main Section for this monster.</p>{{/if}}
      {{#if mainSectionSpecialUnconfigured}}<p class="monster-main-section-incomplete">Special policy has no special rule selected — open the Main Sections dialog and choose one (e.g. Concealed Main Section or Manual Resolution); DEFEATED will not be resolved automatically until then.</p>{{/if}}
      <div class="monster-main-combat-head"><span>Main</span><span>Style</span><span>Section</span><span>Accuracy</span><span>Damage</span><span>Evasion</span><span>Defense</span><span>HP</span><span>MP</span><span></span></div>
      {{#each combatStyles as |style|}}<div class="monster-main-combat-row">
        <input type="checkbox" data-action="select-main-combat-style" data-index="{{style.index}}" aria-label="Main Section: {{style.styleName}}" {{#if style.isMainSection}}checked{{/if}} {{#if style.mainSectionCheckboxDisabled}}disabled{{/if}} {{#unless ../isGM}}disabled{{/unless}}>
        <input name="system.combatStyles.{{style.index}}.style" value="{{style.styleName}}"><span class="monster-section-cell"><input name="system.combatStyles.{{style.index}}.section" value="{{style.section}}">{{#if style.sectionDestroyed}}<span class="section-destroyed-tag" title="This section is at 0 HP or fewer and is destroyed (inactive). Its HP stays fully editable — enter a positive value to heal it.">Destroyed</span>{{/if}}</span><span class="rollable-stat"><button type="button" data-action="roll-monster-accuracy" data-index="{{style.index}}" title="Attack (Accuracy): with one character targeted resolves the attack and asks for the character's Evasion; without a target performs a manual Accuracy roll. GM only."><i class="fas fa-crosshairs"></i></button><input name="system.combatStyles.{{style.index}}.accuracy" value="{{style.accuracy}}" title="Accuracy modifier and static value"></span>
        <span class="rollable-stat"><button type="button" data-action="roll-monster-damage" data-index="{{style.index}}" title="Roll damage (independent of attack)"><i class="fas fa-dice-d6"></i></button><input name="system.combatStyles.{{style.index}}.damage" value="{{style.damage}}" title="Damage formula"></span>
        <input name="system.combatStyles.{{style.index}}.evasion" value="{{style.evasion}}">{{#if style.defenseEditable}}<input type="number" name="system.combatStyles.{{style.index}}.defense" value="{{style.defense}}">{{else}}<span>{{style.defense}}</span>{{/if}}<span class="paired">{{#if style.hpValueEditable}}<input type="number" name="system.combatStyles.{{style.index}}.hp.value" value="{{style.hp.value}}">{{else}}<span>{{style.hp.value}}</span>{{/if}}/{{#if style.hpMaxEditable}}<input type="number" name="system.combatStyles.{{style.index}}.hp.max" value="{{style.hp.max}}">{{else}}<span>{{style.hp.max}}</span>{{/if}}</span><span class="paired">{{#if style.mpValueEditable}}<input type="number" name="system.combatStyles.{{style.index}}.mp.value" value="{{style.mp.value}}">{{else}}<span>{{style.mp.value}}</span>{{/if}}/{{#if style.mpMaxEditable}}<input type="number" name="system.combatStyles.{{style.index}}.mp.max" value="{{style.mp.max}}">{{else}}<span>{{style.mp.max}}</span>{{/if}}</span>{{#if ../isGM}}<button type="button" data-action="delete-monster-style" data-index="{{style.index}}"><i class="fas fa-trash"></i></button>{{/if}}
      </div>{{/each}}
    </section>

    <section class="monster-panel effects-panel">
      <h2>Effects{{#if effectsTab.canRepair}}<span class="class-feature-heading-actions"><button type="button" class="effects-repair" data-action="repair-sw25-effect-data" title="Normalize and repair the data of this sheet's persistent effects. GM only: no write is made when nothing needs fixing; newer-schema and irrecoverable data are never touched."><i class="fas fa-wrench"></i> Repair Data</button></span>{{/if}}</h2>
      <div class="effects-head"><span>Effect</span><span>SV</span><span>Duration</span><span>Anchor</span><span>Source</span><span>State</span><span>Action</span></div>
      <div class="effects-list">
        {{#if effectsTab.nativeStatusRow}}
        <div class="effects-row native-status">
          <span class="effect-name-cell">
            <img class="effect-icon" src="{{effectsTab.nativeStatusRow.img}}" alt="" title="{{effectsTab.nativeStatusRow.name}}">
            <span class="native-status-name">{{effectsTab.nativeStatusRow.displayName}}</span>
            <span class="native-status-badge" title="Native Foundry status, kept in sync with this actor's HP by the system (applied at 0 or fewer HP, removed when HP rises above 0). No duration, no anchor, no manageability.">Native</span>
          </span>
          <span class="effect-sv">—</span>
          <span class="effect-duration">—</span>
          <span class="effect-source">—</span>
          <span class="effect-state">{{effectsTab.nativeStatusRow.stateLabel}}</span>
        </div>
        {{/if}}
        {{#each effectsTab.rows as |row|}}
        <div class="effects-row{{#if row.needsReview}} needs-review{{/if}}">
          <span class="effect-name-cell">
            {{#if row.img}}<img class="effect-icon" src="{{row.img}}" alt="" title="{{row.name}}">{{else}}<i class="effect-icon fas fa-magic" title="{{row.name}}"></i>{{/if}}
            <button type="button" class="paper-link effect-name" data-action="inspect-sw25-effect" data-effect-id="{{row.id}}" title="Inspect this effect">{{row.displayName}}</button>
            {{#if row.needsReview}}<i class="fas fa-triangle-exclamation effect-review-flag" title="Data needs review"></i>{{/if}}
            {{#if row.sectionSelectionLabel}}<span class="monster-concealed-selection" title="{{row.sectionSelectionTitle}}">{{row.sectionSelectionLabel}}</span>{{/if}}
          </span>
          <span class="effect-sv">{{row.successValueLabel}}</span>
          <span class="effect-duration" title="{{row.durationTitle}}">{{row.durationLabel}}</span>
          <span class="effect-anchor" title="{{#if row.anchorUnavailableReason}}Anchor unavailable: {{row.anchorUnavailableReason}}{{else}}{{row.anchorLabel}}{{/if}}">{{#if row.anchorLabel}}{{row.anchorLabel}}{{else}}—{{/if}}</span>
          <span class="effect-source" title="{{row.originUUID}}">{{#if row.originLabel}}{{row.originLabel}}{{else}}—{{/if}}</span>
          <span class="effect-state">{{row.stateLabel}}</span>
          <span class="effect-actions">
            {{#if @root.isGM}}
            <button type="button" class="effect-toggle" data-action="toggle-sw25-effect" data-effect-id="{{row.id}}" data-disabled="{{row.disabled}}" title="{{#if row.disabled}}Activate{{else}}Deactivate{{/if}} effect"><i class="fas {{#if row.disabled}}fa-play{{else}}fa-pause{{/if}}"></i></button>
            <button type="button" class="effect-trash" data-action="remove-sw25-effect" data-effect-id="{{row.id}}" title="Remove effect"><i class="fas fa-trash"></i></button>
            {{/if}}
          </span>
        </div>
        {{else}}
        <p class="paper-empty">No persistent effects.</p>
        {{/each}}
      </div>
      {{#if effectsTab.reviewNote}}<p class="effects-review-note"><i class="fas fa-triangle-exclamation"></i> {{effectsTab.reviewNote}}</p>{{/if}}
    </section>

    <section class="monster-panel monster-unique-skills"><h2>Unique Skills {{#if isGM}}<button type="button" data-action="add-monster-skill"><i class="fas fa-plus"></i></button>{{/if}}</h2>
      {{#each uniqueSkillGroups as |group|}}
      {{#if group.showHeading}}<h3 class="monster-skill-section-heading">{{group.title}}</h3>{{/if}}
      {{#each group.skills as |skill|}}
      <article class="monster-ability {{#if skill.sectionAssignmentChoices.length}}has-section-assignment{{/if}}">
        <input name="system.uniqueSkills.{{skill.index}}.title" value="{{skill.title}}">
        {{#if @root.isGM}}{{#if skill.sectionAssignmentChoices.length}}<button type="button" class="monster-skill-assignment-button {{#if skill.sectionAssignmentNeedsReview}}needs-review{{/if}}" data-action="choose-monster-skill-section" data-index="{{skill.index}}" aria-label="Change section assignment: {{skill.sectionAssignmentLabel}}" title="Section: {{skill.sectionAssignmentLabel}}" {{#if skill.sectionAssignmentNeedsReview}}data-monster-skill-assignment-invalid{{/if}}><i class="fas fa-tag"></i></button>{{/if}}{{/if}}
        <button type="button" data-action="post-monster-skill" data-index="{{skill.index}}" title="Post ability to chat"><i class="fas fa-comment"></i></button>
        {{#if @root.isGM}}<button type="button" data-action="delete-monster-skill" data-index="{{skill.index}}" title="Delete ability"><i class="fas fa-trash"></i></button>{{/if}}
        {{#if skill.sectionAssignmentNeedsReview}}<p class="monster-skill-assignment-warning">This skill's previous section is no longer available. Assign it to a current section or All Sections.</p>{{/if}}
        <textarea name="system.uniqueSkills.{{skill.index}}.description">{{skill.description}}</textarea>
      </article>
      {{/each}}
      {{/each}}
    </section>

    <section class="monster-panel monster-loot"><h2>Loot Table <button type="button" data-action="roll-monster-loot"><i class="fas fa-dice-d6"></i> Roll Loot</button>{{#if isGM}}<button type="button" data-action="add-monster-loot"><i class="fas fa-plus"></i></button>{{/if}}</h2>{{#each lootTable as |entry|}}<div><input name="system.lootTable.{{entry.index}}.roll" value="{{entry.roll}}"><input name="system.lootTable.{{entry.index}}.loot" value="{{entry.loot}}">{{#if ../isGM}}<button type="button" data-action="delete-monster-loot" data-index="{{entry.index}}"><i class="fas fa-trash"></i></button>{{/if}}</div>{{/each}}</section>
    <section class="monster-panel"><h2>Description</h2><textarea class="monster-description" name="system.description">{{system.description}}</textarea><label>Source <input name="system.source" value="{{system.source}}"></label><label>Source URL <input name="system.sourceUrl" value="{{system.sourceUrl}}"></label></section>
  </div>
</form>
