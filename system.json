{
  "id": "sw25-taka",
  "title": "Sword World 2.5: Taka Edition",
  "description": "Unofficial, independently maintained community fork of Sword World 2.5 for Foundry VTT, based on the original system by Daedalus.",
  "version": "0.18.2",
  "url": "https://github.com/matsu-o-taka/Sword-World-2.5-Taka",
  "manifest": "https://raw.githubusercontent.com/matsu-o-taka/Sword-World-2.5-Taka/main/system.json",
  "download": "https://github.com/matsu-o-taka/Sword-World-2.5-Taka/releases/latest/download/sw25-taka.zip",
  "authors": [
    {
      "name": "Daedalus"
    },
    {
      "name": "O-Taka"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "socket": true,
  "esmodules": ["sw25.mjs"],
  "styles": [
    {
      "src": "styles/sw25.css"
    },
    {
      "src": "styles/fellow-sheet.css"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["notes", "biography.notes"]
      },
      "monster": {
        "htmlFields": ["description"]
      },
      "npc": {
        "htmlFields": [
          "biography.notes",
          "npc.appearance",
          "npc.personality",
          "npc.motivation"
        ]
      },
      "fellow": {
        "htmlFields": ["fellow.introduction"]
      }
    },
    "Item": {
      "class": {
        "htmlFields": ["description"]
      },
      "feat": {
        "htmlFields": ["description"]
      },
      "ability": {
        "htmlFields": ["description"]
      },
      "weapon": {
        "htmlFields": ["description"]
      },
      "armour": {
        "htmlFields": ["description"]
      },
      "skill": {
        "htmlFields": ["description"]
      },
      "spell": {
        "htmlFields": ["description"]
      },
      "equipment": {
        "htmlFields": ["description"]
      },
      "race": {
        "htmlFields": ["description"]
      }
    }
  },
  "initiative": "0",
  "primaryTokenAttribute": "hp",
  "secondaryTokenAttribute": "mp"
}
